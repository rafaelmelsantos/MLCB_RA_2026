
import pandas as pd
from sklearn.model_selection import train_test_split
from sklearn.feature_extraction.text import TfidfVectorizer
from sklearn.linear_model import LogisticRegression
from sklearn.metrics import accuracy_score

# 1. Dataset com 15 frases distribuídas em 3 intenções
dados = {
    'texto': [
        # comprar_passagem
        "Quero comprar uma passagem para Paris",
        "Gostaria de reservar um voo para Salvador",
        "Quanto custa a passagem para Orlando?",
        "Preciso comprar dois bilhetes aéreos para Tóquio",
        "Ver preços de voos para o Rio de Janeiro",
        
        # cancelar_reserva
        "Quero cancelar minha reserva de voo",
        "Como faço para anular minha viagem?",
        "Preciso do reembolso da passagem cancelada",
        "Gostaria de cancelar o voo para Lisboa",
        "Desejo anular meu pedido de reserva",
        
        # falar_atendente
        "Preciso falar com um atendente humano",
        "Quero conversar com o suporte ao cliente",
        "Me transfira para um funcionário por favor",
        "Gostaria de suporte presencial ou por telefone",
        "Tem algum operador disponível para me atender?"
    ],
    'intencao': [
        "comprar_passagem", "comprar_passagem", "comprar_passagem", "comprar_passagem", "comprar_passagem",
        "cancelar_reserva", "cancelar_reserva", "cancelar_reserva", "cancelar_reserva", "cancelar_reserva",
        "falar_atendente", "falar_atendente", "falar_atendente", "falar_atendente", "falar_atendente"
    ]
}

df = pd.DataFrame(dados)

# 2. Divisão em Treino e Teste (70% treino, 30% teste)
X_train, X_test, y_train, y_test = train_test_split(
    df['texto'], 
    df['intencao'], 
    test_size=0.3, 
    random_state=42, 
    stratify=df['intencao']
)

# 3. Vetorização do texto com TF-IDF
vectorizer = TfidfVectorizer()
X_train_vec = vectorizer.fit_transform(X_train)
X_test_vec = vectorizer.transform(X_test)

# 4. Treinamento com Regressão Logística
model = LogisticRegression()
model.fit(X_train_vec, y_train)

# Avaliação simples no conjunto de teste
y_pred = model.predict(X_test_vec)
print(f"Acurácia no teste: {accuracy_score(y_test, y_pred):.2f}\n")

# 5 e 6. Predição com 3 frases INÉDITAS e exibição no console
frases_ineditas = [
    "Quero comprar uma passagem barata para Buenos Aires",
    "Preciso anular meu bilhete de voo de amanhã",
    "Por favor me passe para um suporte humano"
]

X_ineditas_vec = vectorizer.transform(frases_ineditas)
predicoes = model.predict(X_ineditas_vec)

print("=== PREDIÇÕES PARA FRASES INÉDITAS ===")
for frase, intencao in zip(frases_ineditas, predicoes):
    print(f"Frase: '{frase}' -> Intenção Prevista: {intencao}")
