nltk.download("stopwords", quiet=True)
stop_words_pt = set(stopwords.words("portuguese"))
nlp = spacy.load("pt_core_news_sm")
print("Ambiente preparado com sucesso.")

def limpar_e_lemmatizar(texto):
    """
    Realiza o pré-processamento de uma mensagem:
    
    1. Converte para minúsculas
    2. Remove caracteres especiais e números
    3. Processa o texto com spaCy
    4. Remove stopwords
    5. Realiza lemmatization
    6. Retorna o texto normalizado
    """
    

    texto_limpo = texto.lower()
    

    texto_limpo = re.sub(
        r'[^a-záàâãéèêíïóôõöúçñ\s]',
        '',
        texto_limpo
    )
    

    doc = nlp(texto_limpo)
    

    tokens_filtrados = []
    
    for token in doc:
        if token.is_space:
            continue
        
        if token.text in stop_words_pt:
            continue
        
        if len(token.text) <= 1:
            continue
        
        tokens_filtrados.append(token.lemma_)
    
    return " ".join(tokens_filtrados)


def analisar_preprocessamento(texto):
    """
    Função de diagnóstico para detalhar cada etapa da esteira de pré-processamento.
    """
    doc_original = nlp(texto)
    tokens_originais = [token.text for token in doc_original if not token.is_space and not token.is_punct]
    
    texto_normalizado = limpar_e_lemmatizar(texto)
    tokens_finais = texto_normalizado.split()
    
    tokens_originais_lower = [t.lower() for t in tokens_originais]
    tokens_removidos = [t for t in tokens_originais_lower if t not in tokens_finais]

    print("--- DIAGNÓSTICO DE PRÉ-PROCESSAMENTO ---")
    print(f"Texto original:\n{texto}\n")
    print(f"Texto normalizado:\n{texto_normalizado}\n")
    print(f"Quantidade de caracteres:\nOriginal: {len(texto)} | Normalizado: {len(texto_normalizado)}\n")
    print(f"Quantidade de tokens antes:\n{len(tokens_originais)}")
    print(f"Quantidade de tokens depois:\n{len(tokens_finais)}")
    print(f"Tokens removidos:\n{tokens_removidos}")
    print(f"Tokens finais:\n{tokens_finais}\n")
    print("-" * 40)


frase_teste = (
    "Gostaria de saber se vocês estão DEVOLVENDO "
    "os valores das mesas compradas!!!"
)

resultado = limpar_e_lemmatizar(frase_teste)
print("Frase original:")
print(frase_teste)

print("\nFrase processada:")
print(resultado)

print("\n")

analisar_preprocessamento(
    "MEU sofá!!! chegou quebrado e quero DEVOLVER!!!"
)
