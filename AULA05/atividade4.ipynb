
import re
import numpy as np
import pandas as pd
import nltk
import spacy
from nltk.corpus import stopwords
from gensim.models import FastText
from sklearn.model_selection import train_test_split
from sklearn.linear_model import LogisticRegression
from sklearn.neighbors import KNeighborsClassifier
from sklearn.metrics import (
    accuracy_score,
    precision_score,
    recall_score,
    f1_score,
    classification_report
)

# Configurações iniciais
nltk.download("stopwords", quiet=True)
stop_words_pt = set(stopwords.words("portuguese"))
nlp = spacy.load("pt_core_news_sm")

# --- EXERCÍCIO 1: Função de Pré-processamento ---
def limpar_e_lemmatizar(texto):
    texto_limpo = texto.lower()
    texto_limpo = re.sub(r'[^a-záàâãéèêíïóôõöúçñ\s]', '', texto_limpo)
    
    doc = nlp(texto_limpo)
    tokens_filtrados = []
    
    for token in doc:
        if token.is_space or token.text in stop_words_pt or len(token.text) <= 1:
            continue
        tokens_filtrados.append(token.lemma_)
        
    return " ".join(tokens_filtrados)


# --- EXERCÍCIOS 2 & 3: Dataset, FastText e Mean Pooling ---
dados_sinteticos = {
    "mensagem": [
        "Olá, gostaria de devolver a mesa que comprei ontem.",
        "Meu sofá chegou quebrado, quero o reembolso!",
        "O produto veio com defeito, preciso devolver urgentemente.",
        "Não gostei do material da estante, quero devolver.",
        "Vocês entregam móveis aqui em São Paulo?",
        "Qual o prazo de entrega do meu guarda-roupa?",
        "Cadê meu pedido que ainda não chegou?",
        "Me ajude a rastrear a entrega da minha cama.",
        "Não gostei da cor da cadeira, quero trocar.",
        "Quero trocar o armário que veio com a porta errada.",
        "Posso trocar a mesa por outro modelo?",
        "Comprei o produto errado, quero trocar."
    ],
    "intencao": [
        "devolucao",
        "devolucao",
        "devolucao",
        "devolucao",
        "duvida_entrega",
        "duvida_entrega",
        "duvida_entrega",
        "duvida_entrega",
        "troca",
        "troca",
        "troca",
        "troca"
    ]
}

df = pd.DataFrame(dados_sinteticos)

corpus_limpo = [limpar_e_lemmatizar(msg) for msg in df["mensagem"].dropna()]
corpus_tokenizado = [frase.split() for frase in corpus_limpo]

# Treinando o FastText
modelo_fasttext = FastText(
    sentences=corpus_tokenizado,
    vector_size=50,
    window=3,
    min_count=1,
    workers=4,
    sg=1
)

def obter_vetor_frase(frase, modelo):
    palavras = frase.split()
    vetores = []

    for palavra in palavras:
        if palavra in modelo.wv:
            vetores.append(modelo.wv[palavra])

    if len(vetores) == 0:
        return np.zeros(modelo.vector_size)

    return np.mean(vetores, axis=0)

X_vetores = np.array([obter_vetor_frase(limpar_e_lemmatizar(msg), modelo_fasttext) for msg in df["mensagem"]])
y = df["intencao"].values

# Divisão treino/teste
X_train_vec, X_test_vec, y_train, y_test = train_test_split(
    X_vetores,
    y,
    test_size=0.25,
    random_state=42,
    stratify=y
)


# --- EXERCÍCIO 4: Laboratório Comparativo (Regressão Logística × KNN) ---

# 1. Instanciar os modelos
modelo_logistico = LogisticRegression(max_iter=1000)
modelo_knn = KNeighborsClassifier(n_neighbors=3)

# 2. Treinar ambos utilizando apenas os dados de treino
modelo_logistico.fit(X_train_vec, y_train)
modelo_knn.fit(X_train_vec, y_train)

# 3. Previsões no conjunto de teste
y_pred_logistico = modelo_logistico.predict(X_test_vec)
y_pred_knn = modelo_knn.predict(X_test_vec)

# 4. Cálculo das Métricas com average="weighted"
acc_log = accuracy_score(y_test, y_pred_logistico)
prec_log = precision_score(y_test, y_pred_logistico, average="weighted", zero_division=0)
rec_log = recall_score(y_test, y_pred_logistico, average="weighted", zero_division=0)
f1_log = f1_score(y_test, y_pred_logistico, average="weighted", zero_division=0)

acc_knn = accuracy_score(y_test, y_pred_knn)
prec_knn = precision_score(y_test, y_pred_knn, average="weighted", zero_division=0)
rec_knn = recall_score(y_test, y_pred_knn, average="weighted", zero_division=0)
f1_knn = f1_score(y_test, y_pred_knn, average="weighted", zero_division=0)

# 5. Exibição da Tabela Comparativa formatada
tabela_comparativa = pd.DataFrame({
    "Modelo": ["Regressão Logística", "KNN"],
    "Accuracy": [f"{acc_log*100:.1f}%", f"{acc_knn*100:.1f}%"],
    "Precision": [f"{prec_log*100:.1f}%", f"{prec_knn*100:.1f}%"],
    "Recall": [f"{rec_log*100:.1f}%", f"{rec_knn*100:.1f}%"],
    "F1": [f"{f1_log*100:.1f}%", f"{f1_knn*100:.1f}%"]
})

print("--- TABELA COMPARATIVA DE RESULTADOS ---")
print(tabela_comparativa.to_string(index=False))
