
import numpy as np
import pandas as pd
from gensim.models import FastText

df = pd.read_csv("sac_moveis_ac2.csv")

corpus_limpo = [limpar_e_lemmatizar(msg) for msg in df["mensagem"].dropna()]

corpus_tokenizado = [frase.split() for frase in corpus_limpo]


print("Treinando o modelo FastText...")
modelo_fasttext = FastText(
    sentences=corpus_tokenizado,
    vector_size=50,
    window=3,
    min_count=1,
    workers=4,
    sg=1
)
print("Modelo FastText treinado com sucesso!")

def obter_vetor_frase(frase, modelo):
    """
    Transforma uma frase em um vetor denso utilizando
    FastText + Mean Pooling.
    """
    palavras = frase.split()
    vetores = []

    for palavra in palavras:
        if palavra in modelo.wv:
            vetor = modelo.wv[palavra]
            vetores.append(vetor)

    if len(vetores) == 0:
        return np.zeros(modelo.vector_size)

    vetor_medio = np.mean(vetores, axis=0)
    
    return vetor_medio

frase_exemplo = "quero devolver meu sofá"
frase_normalizada = limpar_e_lemmatizar(frase_exemplo)
vetor_resultante = obter_vetor_frase(frase_normalizada, modelo_fasttext)

print(f"\nFrase normalizada: '{frase_normalizada}'")
print(f"Dimensão do vetor resultante: {vetor_resultante.shape}")
print(f"Primeiros 5 valores do vetor: {vetor_resultante[:5]}")
